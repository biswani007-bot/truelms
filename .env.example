# ==============================================================================
# TrueLern / LMSCA — Production Environment Configuration (.env.example)
# Target Domain: TrueLern.visital.in
# Target Panel: aaPanel (Node.js Application Manager / PM2)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Runtime Settings
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://TrueLern.visital.in
NEXT_PUBLIC_APP_VERSION=1.0.0

# ------------------------------------------------------------------------------
# 2. Production Database (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.9rxjj.mongodb.net/lmsca?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Security (Generate 64+ char random strings)
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_high_entropy_jwt_secret_64_characters_minimum
JWT_REFRESH_SECRET=replace_with_high_entropy_refresh_secret_64_characters_minimum
CRON_SECRET=replace_with_secure_cron_secret_for_automation

# ------------------------------------------------------------------------------
# 4. CORS & Web Security
# ------------------------------------------------------------------------------
PUBLIC_WEB_ORIGINS=https://TrueLern.visital.in,http://localhost:3000

# ------------------------------------------------------------------------------
# 5. Live Class & Self-Hosted Jitsi Meet Video Stack
# ------------------------------------------------------------------------------
JITSI_APP_ID=truelern-lms
JITSI_APP_SECRET=<CHANGE_ME_PRODUCTION_JWT_SECRET>
# Jitsi Domain (e.g. livetl.visital.in)
JITSI_DOMAIN=livetl.visital.in
JITSI_SERVER_URL=https://livetl.visital.in
RECORDINGS_STORAGE_PATH=/www/wwwroot/livetl.visital.in/recordings

# ------------------------------------------------------------------------------
# 6. Transactional Email (Brevo REST API)
# ------------------------------------------------------------------------------
BREVO_API_KEY=<REPLACE_WITH_YOUR_BREVO_API_KEY>
BREVO_FROM_EMAIL=pabani.visital@gmail.com
BREVO_FROM_NAME="TrueLern"
