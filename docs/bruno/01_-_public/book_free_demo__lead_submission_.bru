meta {
  name: Book Free Demo (Lead Submission)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/public/lead
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
{
  "fullName": "Sarah Jenkins",
