meta {
  name: Change Password
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
{
  "oldPassword": "password123",
  "newPassword": "NewSecurePassword456!"
}
}

docs {
  Changes current user password and invalidates active refresh tokens.
}