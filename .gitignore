npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (allow .env.example)
.env*
!.env.example

# scratch scripts and test outputs
/scratch/
scratch-*.js
scratch-*.ts
test-*.js
test-*.ts
verify-*.js
verify-*.ts
